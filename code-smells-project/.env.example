# Copie para .env e preencha. O .env NÃO é versionado.
# Obrigatória: a aplicação não sobe sem ela.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Opcionais (defaults seguros aplicados quando ausentes)
DEBUG=false
DATABASE_PATH=loja.db
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
API_VERSION=1.0.0

# Validade do token emitido pelo POST /login, em segundos.
# Não existe variável que desligue a autenticação: o ambiente escolhe o
# parâmetro da verificação, nunca se ela acontece.
TOKEN_TTL_SECONDS=3600
