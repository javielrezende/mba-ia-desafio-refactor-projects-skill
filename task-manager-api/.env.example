# Copie para .env e ajuste. O .env NÃO deve ser versionado.

# Obrigatória em produção (FLASK_ENV=production). Em desenvolvimento, uma chave
# efêmera é gerada por processo se esta variável estiver ausente.
SECRET_KEY=troque-por-um-valor-aleatorio-de-32-bytes

FLASK_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=5000

DATABASE_URI=sqlite:///tasks.db

# Origens permitidas no CORS, separadas por vírgula. Não use "*".
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Quando true, as rotas de escrita passam a exigir Authorization: Bearer <token>.
# Default false para preservar o contrato atual da API.
AUTH_REQUIRED=false
TOKEN_TTL_SECONDS=3600

# Notificações por e-mail. Com SMTP_ENABLED=false nada é enviado (apenas logado).
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
