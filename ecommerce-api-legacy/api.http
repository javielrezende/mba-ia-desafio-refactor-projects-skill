@baseUrl = http://localhost:3000
# Valor de desenvolvimento (ver .env.example). Em produção vem de ADMIN_API_KEY.
@adminKey = dev-admin-key-not-a-real-secret

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - nomes de campo novos (equivalente ao anterior)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "userName": "Guilherme",
  "email": "gui2@fullcycle.com.br",
  "password": "senhaforte",
  "courseId": 2,
  "cardNumber": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "senha-valida-8",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Api-Key: {{adminKey}}

### Relatório financeiro paginado
GET {{baseUrl}}/api/admin/financial-report?page=1&per_page=10
X-Admin-Api-Key: {{adminKey}}

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
X-Admin-Api-Key: {{adminKey}}
