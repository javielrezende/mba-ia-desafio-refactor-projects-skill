# Copie para .env e substitua os valores. O .env está no .gitignore.
# Em NODE_ENV=production a ausência de PAYMENT_GATEWAY_KEY ou ADMIN_API_KEY
# derruba o boot — melhor não subir do que subir com segredo default.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ':memory:' ou o caminho de um arquivo SQLite
DATABASE_FILE=:memory:

# Chave do gateway de pagamento (valor fake — use o real via ambiente)
PAYMENT_GATEWAY_KEY=pk_test_substitua_este_valor

# Chave enviada no header X-Admin-Api-Key nas rotas administrativas
ADMIN_API_KEY=substitua_este_valor
